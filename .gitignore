# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependency directories
node_modules/
**/node_modules/

# pnpm
**/.pnp
**/.pnp.js

# Build output
dist/
build/
frontend/build/
frontend/dist/
backend/build/
backend/dist/

# Test output
coverage/
**/coverage/

# Environment files
.env
.env.*.local
**/.env

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS generated files
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# IDEs and editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# Misc
*.tgz
*.zip
*.sqlite
*.db
*.bak
~$*

# One-off project folders
/frontend/.cache/
/frontend/.parcel-cache/

# Keep lockfiles and package manifests under version control (do not ignore package-lock.json or yarn.lock by default)